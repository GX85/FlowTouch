{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=()"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/studio",
      "destination": "/#download",
      "permanent": false
    },
    {
      "source": "/studio/:path*",
      "destination": "/#download",
      "permanent": false
    },
    {
      "source": "/studio.html",
      "destination": "/#download",
      "permanent": false
    },
    {
      "source": "/downloads/FlowTouch.exe",
      "destination": "/downloads/FlowTouch-Studio-Windows.zip",
      "permanent": false
    }
  ]
}